{
  "name": "offscript",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0 <23" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
