# Local milestone. Keep the app bound to 127.0.0.1; there is no account authentication yet.
# The production-mode preview server requires an explicit opt-in. Never use on a public host.
OFFSCRIPT_LOCAL_PREVIEW=1

# Optional environment fallback. You can also connect securely through Tutor settings.
# A saved local connection takes precedence. No fixture answers are substituted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Server-only connection file (ignored by Git). Use a separate path for isolated tests.
OFFSCRIPT_AI_CONFIG_PATH=.data/ai-connection.json

# SQLite file lives on this machine. It is not cloud storage or a backup.
OFFSCRIPT_DB_PATH=.data/offscript.sqlite
